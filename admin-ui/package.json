{
  "name": "terminal-agent-hub-admin-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Terminal Agent Hub 后台 UI（B 线）：管理员登录、用户/组、Provider/Model 授权、用量、会话审阅与审计，默认使用 MSW mock 独立闭环。",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "mock:worker": "msw init public/ --save"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "dayjs": "^1.11.13",
    "pinia": "^3.0.3",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.28.0",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^17.4.0",
    "msw": "^2.8.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.2",
    "vue-tsc": "^2.2.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}