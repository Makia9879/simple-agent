# B 线后台 UI 环境配置。
# 默认 mock 独立闭环（MSW 拦截 /api/v1/*，不连任何真实后端）。
VITE_USE_MOCK=true
VITE_API_BASE_URL=/api/v1

# 切换真实后端（Core API）：
#   VITE_USE_MOCK=false
#   VITE_API_BASE_URL=/api/v1          # 保持同源，由 Vite dev server 代理
#   VITE_PROXY_TARGET=http://localhost:8080
# 真实后端不输出 CORS 头，认证 Cookie 固定在 /api/v1 路径，必须同源访问；
# vite.config.ts 在 USE_MOCK=false 时自动把 /api 代理到 VITE_PROXY_TARGET。
VITE_PROXY_TARGET=http://localhost:8080
